# Copy to .env on the server and fill in. Never commit .env.

APP_ENV=production
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Public hostname whose DNS A record points at the Contabo server's IP.
API_DOMAIN=api.example.com

# Postgres (runs in the db container; docker-compose builds DATABASE_URL from these).
POSTGRES_DB=thenext
POSTGRES_USER=thenext
POSTGRES_PASSWORD=

# Your Vercel frontend origin(s), comma-separated, no trailing slash.
CORS_ORIGINS=https://your-site.vercel.app
FRONTEND_URL=https://your-site.vercel.app

# Admin account, created/updated on every container start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

ENABLED_PAYMENT_METHODS=cod
# ESEWA_MERCHANT_CODE=
# ESEWA_SECRET_KEY=
# STRIPE_SECRET_KEY=
